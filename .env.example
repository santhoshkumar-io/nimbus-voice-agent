# Copy to .env and fill in. The backend reads these (falls back to per-request
# headers from the frontend). NEVER commit the real .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Deploy tokens (optional, for CI/deploy scripts)
RAILWAY_TOKEN=
VERCEL_TOKEN=

# RAG embeddings: "light" (OpenAI embeddings, Railway-friendly) or "rich" (local MiniLM)
EMBEDDING_PROFILE=light
